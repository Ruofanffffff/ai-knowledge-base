# 云端模型API密钥配置
# 请在此文件中配置你的云端模型API密钥

# 字节火山引擎API密钥 (用于图片分析、视频生成、图片生成)
# 获取方式: https://www.volcengine.com/docs/82379/1399008
# 模型: seed1.8 (图片分析), seedance-2.0 (视频生成), seedream-4.5 (图片生成)
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# 通义千问API密钥 (阿里云DashScope) - 用于文本生成
# 获取方式: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API密钥
# 获取方式: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama本地API地址 (可选，默认为 http://localhost:11434/api)
# OLLAMA_API_URL=http://localhost:11434/api

# Database Configuration
# PostgreSQL数据库连接URL
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_base?schema=public"

# S3-Compatible Object Storage Configuration
# S3兼容对象存储配置 (支持AWS S3, MinIO等)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=notes-attachments
S3_REGION=us-east-1
S3_USE_SSL=false

# Notes Feature Configuration
# 便签功能配置
NOTES_MAX_ATTACHMENT_SIZE=10485760  # 10MB in bytes
NOTES_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
NOTES_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
NOTES_ALLOWED_TABLE_TYPES=application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# LLM Configuration for Notes Feature
# 便签功能的LLM配置

# Multi-modal LLM for image analysis (图像分析用多模态LLM)
# 使用字节火山引擎 seed1.8 模型
MULTIMODAL_LLM_PROVIDER=volcengine  # volcengine, qwen, gpt4-vision, claude3
MULTIMODAL_LLM_MODEL=seed1.8
MULTIMODAL_LLM_TIMEOUT=30000

# Text LLM for text enhancement (文本增强用LLM)
# 使用阿里Qwen模型
TEXT_LLM_PROVIDER=qwen  # qwen, gpt4, claude3
TEXT_LLM_MODEL=qwen-max
TEXT_LLM_TIMEOUT=10000

# Video Generation LLM (视频生成用LLM)
# 使用字节火山引擎 seedance 2.0 模型
VIDEO_LLM_PROVIDER=volcengine
VIDEO_LLM_MODEL=seedance-2.0
VIDEO_LLM_TIMEOUT=60000

# Image Generation LLM (图片生成用LLM)
# 使用字节火山引擎 seedream 4.5 模型
IMAGE_GEN_LLM_PROVIDER=volcengine
IMAGE_GEN_LLM_MODEL=seedream-4.5
IMAGE_GEN_LLM_TIMEOUT=30000

# 文档全处理系统配置
# Document Full Processing System Configuration
DOCUMENT_PROCESSING_ENABLED=true
COVERAGE_THRESHOLD_WARNING=0.95
COVERAGE_THRESHOLD_ERROR=0.90
QUALITY_SCORE_THRESHOLD=80
PROCESSING_TIMEOUT_MS=300000
SEGMENTATION_SIZE_THRESHOLD_MB=10
SEGMENTATION_UNIT_THRESHOLD=5000
SEGMENT_SIZE=1000
SEGMENT_CONCURRENCY=3

# Schema 驱动知识图谱配置
# Schema-Driven Knowledge Graph Configuration

# 知识图谱功能开关
KG_ENABLED=true

WIKI_ENABLED=1

# 知识图谱构建状态追踪配置
# Knowledge Graph Build Status Tracking Configuration

# 最大并发构建数量 (同时处理的文档数量)
KG_MAX_CONCURRENT_BUILDS=3

# 构建超时时间 (毫秒) - 单个文档的最大处理时间
KG_BUILD_TIMEOUT=300000

# 前端轮询间隔 (毫秒) - 状态查询的频率
KG_POLLING_INTERVAL=2000

# 状态缓存时间 (毫秒) - 客户端缓存状态响应的时间
KG_STATUS_CACHE_TTL=1000

# Schema 配置
KG_SCHEMA_AUTO_CHECK=true
KG_SCHEMA_MIN_COUNT=250
KG_SCHEMA_AUTO_IMPORT=true

# Token 预算管理
KG_TOKEN_DAILY_LIMIT=100000
KG_TOKEN_PER_DOCUMENT_LIMIT=5000
KG_TOKEN_WARNING_THRESHOLD=0.8
KG_TOKEN_EMERGENCY_THRESHOLD=1.0

# LLM 调用频率控制
KG_LLM_FIELD_EXTRACTION_RATE=1.0
KG_LLM_FIELD_MAPPING_RATE=0.5
KG_LLM_ENTITY_CANONICAL_NAME_RATE=0.5
KG_LLM_ENTITY_DISAMBIGUATION_RATE=0.3
KG_LLM_SEMANTIC_RELATION_HIGH_PRIORITY_RATE=0.3
KG_LLM_SEMANTIC_RELATION_RANDOM_SAMPLE_RATE=0.2

# 性能约束
KG_LOCAL_PROCESSING_TIMEOUT_MS=1000
KG_LLM_CALL_TIMEOUT_MS=10000
KG_TOTAL_PROCESSING_TIMEOUT_MS=30000
KG_SLOW_QUERY_THRESHOLD_MS=500

# 置信度阈值
KG_MIN_ENTITY_CONFIDENCE=0.5
KG_MIN_RELATION_CONFIDENCE=0.5
KG_MIN_QUALITY_SCORE=0.6

# 缓存配置
KG_CACHE_ENABLED=true
KG_CACHE_TTL_HOURS=24
KG_CACHE_MAX_SIZE_MB=100

# 同义词词典配置
KG_SYNONYM_DICT_AUTO_EXPAND=true
KG_SYNONYM_DICT_LEARNING_ENABLED=true
KG_SYNONYM_DICT_MIN_COVERAGE=0.9

# 字段映射失败率告警阈值
KG_FIELD_MAPPING_FAILURE_THRESHOLD=0.2

# 批量处理配置
KG_BATCH_SIZE=10
KG_BATCH_CONCURRENCY=3

# LLM字段提取配置 (阶段2: 关系抽取优化)
# LLM Field Extraction Configuration (Phase 2: Relation Extraction Optimization)

# 启用LLM字段提取增强
ENABLE_LLM_FIELD_EXTRACTION=false

# LLM批量处理配置
LLM_BATCH_SIZE=20
LLM_MAX_CONCURRENT=3
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=2

# 字段提取策略
FIELD_EXTRACTION_STRATEGY=schema-aware
CRITICAL_FIELD_WEIGHT_THRESHOLD=0.3

# 性能配置
FIELD_EXTRACTION_BATCH_SIZE=20
ENABLE_FIELD_EXTRACTION_CACHE=true

# LLM文档索引预处理配置
# LLM Document Index Preprocessing Configuration

# ========== 主开关 ==========
# 启用LLM文档索引预处理 (主开关)
# 设置为true时，系统将在知识图谱构建前生成文档索引并进行各阶段矫正
ENABLE_LLM_PREPROCESSING=false

# ========== LLM调用配置 ==========
# LLM预处理温度参数 (0-1, 越低越确定性，建议0.1保持事实性)
LLM_PREPROCESSING_TEMPERATURE=0.1

# LLM预处理最大Token数
LLM_PREPROCESSING_MAX_TOKENS=2000

# ========== 超时配置 (毫秒) ==========
# 文档索引生成超时 (默认30秒)
LLM_PREPROCESSING_DOCUMENT_INDEX_TIMEOUT=30000

# CBK描述矫正超时 (默认10秒)
LLM_PREPROCESSING_CBK_CORRECTION_TIMEOUT=10000

# 字段提取矫正超时 (默认15秒)
LLM_PREPROCESSING_FIELD_CORRECTION_TIMEOUT=15000

# Schema选择矫正超时 (默认10秒)
LLM_PREPROCESSING_SCHEMA_CORRECTION_TIMEOUT=10000

# 实体合并矫正超时 (默认10秒)
LLM_PREPROCESSING_MERGE_CORRECTION_TIMEOUT=10000

# 关系抽取矫正超时 (默认20秒)
LLM_PREPROCESSING_RELATION_CORRECTION_TIMEOUT=20000

# 图谱描述生成超时 (默认30秒)
LLM_PREPROCESSING_GRAPH_DESCRIPTION_TIMEOUT=30000

# ========== 并发控制配置 ==========
# 最大并发LLM调用数量 (默认5)
LLM_PREPROCESSING_MAX_CONCURRENCY=5

# 队列超时时间 (毫秒，默认60秒)
LLM_PREPROCESSING_QUEUE_TIMEOUT=60000

# ========== 缓存配置 ==========
# 启用LLM调用结果缓存 (默认true)
LLM_PREPROCESSING_CACHE_ENABLED=true

# 缓存最大条目数 (默认1000)
LLM_PREPROCESSING_CACHE_MAX_SIZE=1000

# 缓存过期时间 (毫秒，默认1小时)
LLM_PREPROCESSING_CACHE_TTL=3600000

# ========== 智能触发阈值配置 ==========
# 字段覆盖率阈值 (低于此值触发补充提取，默认0.8)
LLM_PREPROCESSING_FIELD_COVERAGE_THRESHOLD=0.8

# 关系覆盖率阈值 (低于此值触发补充提取，默认0.7)
LLM_PREPROCESSING_RELATION_COVERAGE_THRESHOLD=0.7

# Schema验证置信度阈值 (低于此值触发二次验证，默认0.75)
LLM_PREPROCESSING_SCHEMA_CONFIDENCE_THRESHOLD=0.75

# Human-Readable Knowledge Graph 配置
# Human-Readable Knowledge Graph Configuration

# 主开关 - 启用所有人类可读功能
ENABLE_HUMAN_READABLE_KG=true

# 实体名称标准化
ENABLE_ENTITY_NAME_STANDARDIZATION=true

# 关系描述生成
ENABLE_RELATION_DESCRIPTIONS=true
DESCRIPTION_GENERATION_METHOD=auto
ENABLE_RELATION_DESCRIPTION_LLM=false
RELATION_DESCRIPTION_LANGUAGE=zh

# 层级关系抽取
ENABLE_HIERARCHICAL_EXTRACTION=false
HIERARCHICAL_EXTRACTION_METHOD=pattern
HIERARCHICAL_MIN_CONFIDENCE=0.7

# Universal Document Pipeline 配置
# Universal Document Pipeline Configuration

# Pipeline 模式开关 (true=启用Pipeline模式, false=使用传统kgService模式)
USE_PIPELINE=false

# Pipeline 字段提取配置
PIPELINE_EXTRACTION_USE_LLM=false
PIPELINE_EXTRACTION_USE_NER=true
PIPELINE_EXTRACTION_USE_RULES=true

# Pipeline 字段标准化配置
PIPELINE_NORMALIZATION_USE_LLM=false
PIPELINE_NORMALIZATION_USE_ALGORITHM=true

# Pipeline 实体构建配置
PIPELINE_ENTITY_USE_LLM=false
PIPELINE_ENTITY_ALLOW_PARTIAL=true

# Pipeline 关系抽取配置
PIPELINE_RELATION_BUILTIN=true
PIPELINE_RELATION_COOCCURRENCE=true
PIPELINE_RELATION_SEMANTIC=false

# ========== 知识图谱API分离配置 ==========
# Knowledge Graph API Separation Configuration

# 自动构建开关 (true=文档创建/更新/删除时自动触发KG构建, false=需要手动调用API触发)
# 默认false，推荐通过API手动控制KG构建
AUTO_BUILD_KG=false

# KG服务启用开关 (true=启用KG服务, false=禁用KG服务)
KG_SERVICE_ENABLED=true

# 最大并发构建数 (同时处理的KG构建任务数量)
KG_MAX_CONCURRENT=3

# 单个KG构建超时时间 (毫秒)
KG_BUILD_TIMEOUT=300000

# 是否启用构建队列 (true=使用队列管理并发, false=直接执行)
KG_ENABLE_QUEUE=true

# 队列最大长度 (超过此长度将拒绝新任务)
KG_QUEUE_MAX_LENGTH=100

# 注意事项:
# 1. 请将 your_qwen_api_key_here 和 your_deepseek_api_key_here 替换为真实的API密钥
# 2. 不要将包含真实API密钥的.env文件提交到版本控制系统
# 3. 请妥善保管你的API密钥，避免泄露
# 4. 配置完成后需要重启服务器才能生效
# 5. KG 相关配置可根据实际需求调整,建议先使用默认值
# 6. AUTO_BUILD_KG=false 时，需要通过 POST /api/kg/build 手动触发KG构建

# KG监控和告警配置
# 失败率告警阈值 (0.1 = 10%)
KG_ALERT_FAILURE_RATE=0.1

# 平均构建时间告警阈值 (毫秒)
KG_ALERT_AVG_BUILD_TIME=300000

# 队列长度告警阈值
KG_ALERT_QUEUE_LENGTH=50

# ========== Authen 统一认证平台配置 ==========
# Authen Unified Authentication Platform Configuration

# Authen Gateway API 地址 (默认 http://localhost:8008)
# Authen Gateway 的 API 网关服务地址，所有认证请求通过此地址转发
AUTHEN_GATEWAY_URL=http://localhost:8008

# Authen 应用凭证 - 应用 ID
# 由 Authen 管理后台分配，用于标识接入应用，通过 X-App-Id 请求头传递
# 未配置时系统将回退到本地认证模式
AUTHEN_APP_ID=your-authen-app-id

# Authen 应用凭证 - 应用密钥
# 由 Authen 管理后台分配，与 APP_ID 配对使用，通过 X-App-Secret 请求头传递
AUTHEN_APP_SECRET=your-authen-app-secret

# Authen JWT 密钥 (HS256)
# 用于在本地验证 Authen 签发的 access_token，避免每次请求都调用 Authen Gateway
# 必须与 Authen 服务端配置的 JWT 签名密钥一致
AUTHEN_JWT_SECRET=your-authen-jwt-secret
