# Frontend-Backend Integration - Production Environment Configuration
# This file configures the React frontend for production deployment

# API Configuration
# Base URL for all API requests - REPLACE WITH YOUR PRODUCTION API URL
# Example: https://api.yourdomain.com/api or https://yourdomain.com/api
VITE_API_BASE_URL=https://your-production-domain.com/api

# Auto-Refresh Configuration
# Enable automatic data refresh for documents and knowledge graph
VITE_ENABLE_AUTO_REFRESH=true

# Auto-refresh interval in milliseconds (60000ms = 60 seconds)
# Longer interval for production to reduce server load
VITE_AUTO_REFRESH_INTERVAL=60000

# Debug Mode
# Disable debug logging in production for security and performance
VITE_DEBUG_MODE=false
