# Anchor-Driven Entity Synthesis - Production Environment Variables
# Copy this file to your production server and merge with existing .env file

# ============================================================================
# ANCHOR SYSTEM CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=production

# Feature Flags
ANCHOR_MODE_ENABLED=true
ANCHOR_COMPATIBILITY_MODE=ANCHOR_ONLY
ANCHOR_CONFLICT_DETECTION=true
ANCHOR_LLM_ADVISORY=false
ANCHOR_CACHING_ENABLED=true
ANCHOR_METRICS_ENABLED=true
ANCHOR_PROFILING_ENABLED=false

# Performance Constraints (Strict Production Targets)
ANCHOR_MAX_TIME_PER_INSTANCE=10
ANCHOR_WARN_TIME_PER_INSTANCE=5
ANCHOR_MAX_TIME_FOR_1000=100
ANCHOR_WARN_TIME_FOR_1000=50

# Cache Configuration
ANCHOR_CACHE_MAX_SIZE=100000
ANCHOR_CACHE_TTL=14400000

# Conflict Detection Thresholds
ANCHOR_VALUE_CONFLICT_PERCENT=10
ANCHOR_HIGH_SEVERITY_PERCENT=50

# LLM Advisory Configuration (Optional - Disabled by default)
ANCHOR_LLM_PROVIDER=qwen
ANCHOR_LLM_MODEL=qwen-turbo
ANCHOR_LLM_TEMPERATURE=0.2
ANCHOR_LLM_MAX_TOKENS=400
ANCHOR_LLM_MIN_SEVERITY=high
ANCHOR_LLM_MIN_CONFIDENCE=0.8
ANCHOR_LLM_MAX_CALLS_PER_MINUTE=20
ANCHOR_LLM_MAX_CALLS_PER_HOUR=300

# Logging Configuration (Minimal in Production)
ANCHOR_LOG_LEVEL=warn
ANCHOR_LOG_DETAILED=false
ANCHOR_LOG_ANCHOR_GENERATION=false
ANCHOR_LOG_MERGING=false
ANCHOR_LOG_CONFLICTS=false
ANCHOR_LOG_LLM_CALLS=true
ANCHOR_LOG_PERFORMANCE=false

# Monitoring Configuration
ANCHOR_MONITORING_ENABLED=true
ANCHOR_METRICS_EXPORT_INTERVAL=60000

# Alert Thresholds
ANCHOR_ALERT_GENERATION_TIME=50
ANCHOR_ALERT_MERGE_TIME=500
ANCHOR_ALERT_ERROR_RATE=0.01
ANCHOR_ALERT_MEMORY_USAGE=0.8
ANCHOR_ALERT_CPU_USAGE=0.8

# Database Configuration
ANCHOR_USE_ANCHOR_FIELDS=true
ANCHOR_USE_INDEXES=true
ANCHOR_CACHE_QUERIES=true
ANCHOR_CONNECTION_POOL_SIZE=20

# Production-Specific
ANCHOR_STRICT_MODE=true
ANCHOR_GRACEFUL_DEGRADATION=true
ANCHOR_CIRCUIT_BREAKER_ENABLED=true
ANCHOR_CIRCUIT_BREAKER_THRESHOLD=0.5
ANCHOR_CIRCUIT_BREAKER_TIMEOUT=60000
ANCHOR_CIRCUIT_BREAKER_RESET_TIMEOUT=300000
ANCHOR_HEALTH_CHECKS_ENABLED=true
ANCHOR_HEALTH_CHECK_INTERVAL=30000
ANCHOR_HEALTH_CHECK_TIMEOUT=5000
ANCHOR_VALIDATE_INPUT=true
ANCHOR_SANITIZE_OUTPUT=true
ANCHOR_RATE_LIMITING=true

# ============================================================================
# EXISTING SYSTEM CONFIGURATION (Keep your existing values)
# ============================================================================

# API Keys (Keep your existing keys)
# QWEN_API_KEY=your_qwen_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Knowledge Graph Configuration (Keep your existing values)
# KG_ENABLED=true
# KG_SCHEMA_AUTO_CHECK=true
# ... (other KG settings)

# Pipeline Configuration (Keep your existing values)
# USE_PIPELINE=false
# ... (other pipeline settings)
