# Anchor-Driven Entity Synthesis - Staging Environment Variables
# Copy this file to your staging server and merge with existing .env file

# ============================================================================
# ANCHOR SYSTEM CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=staging

# Feature Flags
ANCHOR_MODE_ENABLED=true
ANCHOR_COMPATIBILITY_MODE=ANCHOR_ONLY
ANCHOR_CONFLICT_DETECTION=true
ANCHOR_LLM_ADVISORY=false
ANCHOR_CACHING_ENABLED=true
ANCHOR_METRICS_ENABLED=true
ANCHOR_PROFILING_ENABLED=true

# Performance Constraints (Production Targets)
ANCHOR_MAX_TIME_PER_INSTANCE=10
ANCHOR_WARN_TIME_PER_INSTANCE=5
ANCHOR_MAX_TIME_FOR_1000=100
ANCHOR_WARN_TIME_FOR_1000=50

# Cache Configuration
ANCHOR_CACHE_MAX_SIZE=50000
ANCHOR_CACHE_TTL=7200000

# Conflict Detection Thresholds
ANCHOR_VALUE_CONFLICT_PERCENT=10
ANCHOR_HIGH_SEVERITY_PERCENT=50

# LLM Advisory Configuration (Optional)
ANCHOR_LLM_PROVIDER=qwen
ANCHOR_LLM_MODEL=qwen-turbo
ANCHOR_LLM_TEMPERATURE=0.2
ANCHOR_LLM_MAX_TOKENS=400
ANCHOR_LLM_MIN_SEVERITY=high
ANCHOR_LLM_MIN_CONFIDENCE=0.7
ANCHOR_LLM_MAX_CALLS_PER_MINUTE=30
ANCHOR_LLM_MAX_CALLS_PER_HOUR=500

# Logging Configuration
ANCHOR_LOG_LEVEL=info
ANCHOR_LOG_DETAILED=true
ANCHOR_LOG_ANCHOR_GENERATION=false
ANCHOR_LOG_MERGING=false
ANCHOR_LOG_CONFLICTS=true
ANCHOR_LOG_LLM_CALLS=true
ANCHOR_LOG_PERFORMANCE=true

# Monitoring Configuration
ANCHOR_MONITORING_ENABLED=true
ANCHOR_METRICS_EXPORT_INTERVAL=30000

# Database Configuration
ANCHOR_USE_ANCHOR_FIELDS=true
ANCHOR_USE_INDEXES=true
ANCHOR_CACHE_QUERIES=true

# Staging-Specific
ANCHOR_VALIDATION_MODE=true
ANCHOR_DATA_INTEGRITY_CHECKS=true
ANCHOR_PERFORMANCE_BENCHMARKING=true
ANCHOR_DETAILED_ERRORS=true
ANCHOR_TEST_DATA_ENABLED=true
ANCHOR_TEST_DATA_SAMPLE_SIZE=100

# ============================================================================
# EXISTING SYSTEM CONFIGURATION (Keep your existing values)
# ============================================================================

# API Keys (Keep your existing keys)
# QWEN_API_KEY=your_qwen_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Knowledge Graph Configuration (Keep your existing values)
# KG_ENABLED=true
# KG_SCHEMA_AUTO_CHECK=true
# ... (other KG settings)

# Pipeline Configuration (Keep your existing values)
# USE_PIPELINE=false
# ... (other pipeline settings)
