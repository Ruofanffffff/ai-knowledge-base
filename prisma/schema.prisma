// This is your Prisma schema file, // learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/knowledge_graph.db"
}

// 用户表
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   @map("hashedPassword")
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联关系
  documents               Document[]
  settings                Setting[]
  backups                 Backup[]
  notes                   Note[] // 新增: 便签关联
  shortVideoSources       ShortVideoSource[]
  shortVideoDigestSetting ShortVideoDigestSetting?
  shortVideoDailyDigests  ShortVideoDailyDigest[]
  // memories  Memory[] // Relation removed to avoid foreign key issues with legacy DB

  @@map("users")
}

// 文档表
model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("document")
  fileType  String? // .md, .pdf, .docx, .txt
  metadata  String? // 文档元数据 (JSON string)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联关系
  user          User?           @relation(fields: [userId], references: [id])
  tags          DocumentTag[]
  searchItems   SearchHistory[]
  imageAnalyses ImageAnalysis[]

  @@map("documents")
}

// 标签表
model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  color       String        @default("#999999")
  description String?
  documentTag DocumentTag[]

  @@map("tags")
}

// 文档标签关联表
model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

// 搜索历史表
model SearchHistory {
  id         String   @id @default(uuid())
  query      String
  documentId String?
  userId     String?
  score      Float? // 搜索结果的相关度
  createdAt  DateTime @default(now())

  // 关联关系
  document Document? @relation(fields: [documentId], references: [id])

  @@map("search_history")
}

// 备份表
model Backup {
  id          String   @id @default(uuid())
  filePath    String
  size        Int
  description String?
  userId      String?
  createdAt   DateTime @default(now())

  // 关联关系
  user User? @relation(fields: [userId], references: [id])

  @@map("backups")
}

// 设置表
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String // JSON string
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联关系
  user User? @relation(fields: [userId], references: [id])

  @@map("settings")
}

// ============================================
// LLM Document Index Preprocessing Models
// ============================================

// 文档索引表
// 存储LLM生成的文档索引叙述文本
model DocumentIndex {
  id          String   @id @default(uuid())
  docId       String   @map("doc_id")
  indexedText String   @map("indexed_text") // 索引叙述文本
  metadata    String // JSON string: {generated_at, llm_model, token_count, fact_count, etc.}
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([docId])
  @@index([createdAt])
  @@map("document_index")
}

// ============================================
// Notes Feature Models
// ============================================

// 便签表
model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  tags      String // JSON string for SQLite compatibility
  status    String   @default("archived")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attachments Attachment[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notes")
}

// 附件表
model Attachment {
  id         String   @id @default(uuid())
  noteId     String   @map("note_id")
  type       String // Changed from enum to String for SQLite
  storageKey String   @map("storage_key") // S3对象键
  url        String
  size       Int
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")

  analysis AttachmentAnalysis?
  note     Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([type])
  @@map("attachments")
}

// 附件分析表
model AttachmentAnalysis {
  id           String   @id @default(uuid())
  attachmentId String   @unique @map("attachment_id")
  textContent  String?  @map("text_content")
  description  String?
  tags         String // JSON string for SQLite compatibility
  metadata     String // JSON string for SQLite compatibility
  createdAt    DateTime @default(now()) @map("created_at")

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@map("attachment_analysis")
}

// ============================================
// Short Video Ingest Models (抖音/短视频导入)
// ============================================

model ShortVideoSource {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  platform      String   @default("unknown")
  originalUrl   String   @map("original_url")
  normalizedUrl String   @map("normalized_url")
  inputText     String?  @map("input_text")
  ingestLevel   String   @default("L0") // L0/L1/L2/L3
  status        String   @default("queued") // queued/running/succeeded/failed/canceled
  progress      String? // JSON string
  error         String?
  noteQuickId   String?  @map("note_quick_id")
  noteRefinedId String?  @map("note_refined_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts ShortVideoArtifact[]

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@map("short_video_sources")
}

model ShortVideoArtifact {
  id        String   @id @default(uuid())
  sourceId  String   @map("source_id")
  kind      String
  payload   String
  metadata  String // JSON string
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  source ShortVideoSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([kind])
  @@index([createdAt])
  @@map("short_video_artifacts")
}

model ShortVideoDigestSetting {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  enabled   Boolean  @default(true)
  hour      Int      @default(20)
  minute    Int      @default(0)
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_video_digest_settings")
}

model ShortVideoDailyDigest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String // YYYY-MM-DD (server timezone)
  content   String // JSON string
  status    String   @default("ready")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([createdAt])
  @@map("short_video_daily_digests")
}

// ============================================
// KG Post-Processing Cleaned Models (图谱字段表)
// ============================================

// 清洗实体表 — 图谱字段表的实体部分
model CleanedEntity {
  id              String   @id @default(uuid())
  cleanedName     String   @map("cleaned_name") // 清洗后名称，≤6个字
  description     String // 清洗后描述，≤20个字
  sourceEntityIds String   @map("source_entity_ids") // JSON string: 关联的原始 KGEntity ID 列表
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  relationsAsSource CleanedRelation[] @relation("CleanedSourceEntity")
  relationsAsTarget CleanedRelation[] @relation("CleanedTargetEntity")

  @@index([cleanedName])
  @@map("cleaned_entities")
}

// 清洗关系表 — 图谱字段表的关系部分
model CleanedRelation {
  id                String   @id @default(uuid())
  cleanedName       String   @map("cleaned_name") // 清洗后关系名称，≤4个字
  description       String // 关系描述
  sourceEntityId    String   @map("source_entity_id") // 关联的 CleanedEntity（源）
  targetEntityId    String   @map("target_entity_id") // 关联的 CleanedEntity（目标）
  sourceRelationIds String   @map("source_relation_ids") // JSON string: 关联的原始 KGRelation ID 列表
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  source CleanedEntity @relation("CleanedSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  target CleanedEntity @relation("CleanedTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("cleaned_relations")
}

// ============================================
// KG Dual-Layer Graph Models (双层知识图谱)
// ============================================

// 分文章实体表 — 按文档隔离的实体
model DocEntity {
  id          String   @id @default(uuid())
  docId       String   @map("doc_id")
  cleanedName String   @map("cleaned_name") // ≤6个字
  description String // ≤30个字
  entityType  String   @default("concept") @map("entity_type") // Entity_Type 枚举值
  source      String   @default("fact") // Source_Tag
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  relationsAsSource DocRelation[] @relation("DocSourceEntity")
  relationsAsTarget DocRelation[] @relation("DocTargetEntity")

  @@index([docId])
  @@index([cleanedName])
  @@map("doc_entities")
}

// 分文章关系表 — 按文档隔离的关系
model DocRelation {
  id             String   @id @default(uuid())
  docId          String   @map("doc_id")
  cleanedName    String   @map("cleaned_name") // ≤4个字
  description    String // ≤20个字
  layer          String   @default("how") // "how" | "why"
  source         String   @default("fact") // Source_Tag
  sourceEntityId String   @map("source_entity_id")
  targetEntityId String   @map("target_entity_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sourceEntity DocEntity @relation("DocSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity DocEntity @relation("DocTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("doc_relations")
}

// 分文章原则表 — So What 层提取的原则和模式
model DocPrinciple {
  id               String   @id @default(uuid())
  docId            String   @map("doc_id")
  name             String // ≤8个字
  description      String // ≤40个字
  relatedEntityIds String   @map("related_entity_ids") // JSON string: DocEntity ID 列表
  source           String   @default("pattern") // Source_Tag
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([docId])
  @@map("doc_principles")
}

// 统一实体表 — 语义归纳后的上层概念实体
model UnifiedEntity {
  id                 String   @id @default(uuid())
  cleanedName        String   @map("cleaned_name") // ≤6个字
  description        String // ≤20个字，包含目录和总结
  entityType         String   @default("concept") @map("entity_type") // 新增：Entity_Type 枚举值
  source             String   @default("fact") // 新增：Source_Tag
  sourceDocEntityIds String   @map("source_doc_entity_ids") // JSON: 关联的 DocEntity ID 列表
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  relationsAsSource UnifiedRelation[] @relation("UnifiedSourceEntity")
  relationsAsTarget UnifiedRelation[] @relation("UnifiedTargetEntity")

  @@index([cleanedName])
  @@map("unified_entities")
}

// 统一关系表 — 语义归纳后的上层概念关系
model UnifiedRelation {
  id                   String   @id @default(uuid())
  cleanedName          String   @map("cleaned_name") // ≤4个字
  description          String // ≤20个字
  layer                String   @default("how") // 新增："how" | "why"
  source               String   @default("fact") // 新增：Source_Tag
  sourceEntityId       String   @map("source_entity_id")
  targetEntityId       String   @map("target_entity_id")
  sourceDocRelationIds String   @map("source_doc_relation_ids") // JSON: 关联的 DocRelation ID 列表
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sourceEntity UnifiedEntity @relation("UnifiedSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity UnifiedEntity @relation("UnifiedTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("unified_relations")
}

// 统一原则表 — 语义归纳后的上层原则和模式
model UnifiedPrinciple {
  id                    String   @id @default(uuid())
  name                  String // ≤8个字
  description           String // ≤40个字
  source                String   @default("pattern") // Source_Tag
  sourceDocPrincipleIds String   @map("source_doc_principle_ids") // JSON string
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("unified_principles")
}

// 统一归纳日志表 — 记录每次统一归纳的执行状态
model UnificationLog {
  id             String    @id @default(uuid())
  status         String // 'running' | 'completed' | 'failed'
  entityCount    Int       @default(0) @map("entity_count")
  relationCount  Int       @default(0) @map("relation_count")
  principleCount Int       @default(0) @map("principle_count") // 新增
  triggeredBy    String    @map("triggered_by") // 'scheduler' | 'manual'
  error          String?
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("unification_logs")
}

// ============================================
// AI Insights Persistence (AI 洞察持久化)
// ============================================

model DocumentInsight {
  id         String   @id @default(uuid())
  docId      String   @unique @map("doc_id")
  concepts   String // JSON string
  references String // JSON string
  summary    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([docId])
  @@map("document_insights")
}

// ============================================
// Image Analysis Models (图片 AI 识别)
// ============================================

// 图片分析表 — 存储 LLM 对图片的识别结果
model ImageAnalysis {
  id          String   @id @default(uuid())
  imageKey    String   @map("image_key")
  imageUrl    String   @map("image_url")
  description String?
  elements    String?
  theme       String?
  status      String   @default("pending")
  error       String?
  documentId  String?  @map("document_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([imageKey])
  @@index([documentId])
  @@index([status])
  @@map("image_analyses")
}

// ============================================
// Knowledge Growth Models (知识生长)
// ============================================

// 认知碎片表
model CognitiveFragment {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  fragmentType String   @map("fragment_type")
  content      String
  sourceId     String   @map("source_id")
  sourceMeta   String?  @map("source_meta")
  embedding    String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([sourceId, createdAt])
  @@map("cognitive_fragments")
}

// 知识体表
model KnowledgeBody {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  themeName          String   @map("theme_name")
  themeDescription   String   @map("theme_description")
  confidenceScore    Float    @default(0.3) @map("confidence_score")
  growthPhase        String   @default("discovery") @map("growth_phase")
  relatedFragmentIds String   @map("related_fragment_ids")
  relatedEntityIds   String?  @map("related_entity_ids")
  exportedDocId      String?  @map("exported_doc_id")
  themeEmbedding     String?  @map("theme_embedding")
  parentId           String?  @map("parent_id")
  bodyType           String   @default("topic") @map("body_type")
  lifecycleStatus    String   @default("active") @map("lifecycle_status")
  lastActiveAt       DateTime @default(now()) @map("last_active_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  parent             KnowledgeBody?      @relation("BodyHierarchy", fields: [parentId], references: [id])
  children           KnowledgeBody[]     @relation("BodyHierarchy")
  nodes              KnowledgeBodyNode[]
  themeEvolutionLogs ThemeEvolutionLog[]

  @@index([userId, growthPhase])
  @@index([parentId])
  @@index([userId, bodyType])
  @@index([userId, lifecycleStatus])
  @@map("knowledge_bodies")
}

// 知识体大纲节点表
model KnowledgeBodyNode {
  id             String   @id @default(uuid())
  bodyId         String   @map("body_id")
  parentNodeId   String?  @map("parent_node_id")
  title          String
  status         String   @default("gap")
  content        String?
  generationMode String?  @map("generation_mode")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  body     KnowledgeBody       @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  parent   KnowledgeBodyNode?  @relation("NodeHierarchy", fields: [parentNodeId], references: [id])
  children KnowledgeBodyNode[] @relation("NodeHierarchy")

  @@index([bodyId])
  @@index([parentNodeId])
  @@map("knowledge_body_nodes")
}

// 主题发现日志表
model ThemeDiscoveryLog {
  id                  String    @id @default(uuid())
  status              String
  themesFound         Int       @default(0) @map("themes_found")
  fragmentsScanned    Int       @default(0) @map("fragments_scanned")
  triggeredBy         String    @map("triggered_by")
  error               String?
  intentBodiesCreated Int       @default(0) @map("intent_bodies_created")
  bodiesMerged        Int       @default(0) @map("bodies_merged")
  stage4Error         String?   @map("stage4_error")
  staleCount          Int       @default(0) @map("stale_count")
  archivedCount       Int       @default(0) @map("archived_count")
  stage5Error         String?   @map("stage5_error")
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("theme_discovery_logs")
}

// 主题演化日志表
model ThemeEvolutionLog {
  id                       String   @id @default(uuid())
  bodyId                   String   @map("body_id")
  previousThemeName        String   @map("previous_theme_name")
  previousThemeDescription String   @map("previous_theme_description")
  newThemeName             String   @map("new_theme_name")
  newThemeDescription      String   @map("new_theme_description")
  driftScore               Float    @map("drift_score")
  createdAt                DateTime @default(now()) @map("created_at")

  body KnowledgeBody @relation(fields: [bodyId], references: [id], onDelete: Cascade)

  @@index([bodyId])
  @@index([createdAt])
  @@map("theme_evolution_logs")
}

// ============================================
// Memory Models (记忆模型)
// ============================================

model Memory {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  type            String
  content         String
  embedding       String
  importanceScore Float    @map("importance_score")
  lastAccessedAt  DateTime @map("last_accessed_at")
  metadata        String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // user            User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Removed

  @@index([userId])
  @@map("memories")
}

model WikiSource {
  id String @id @default(uuid())

  userId      String   @map("user_id")
  sourceType  String   @map("source_type")
  sourceId    String?  @map("source_id")
  sourceUrl   String?  @map("source_url")
  title       String?
  rawContent  String?  @map("raw_content")
  contentHash String?  @map("content_hash")

  status         String    @default("queued")
  progress       String?
  error          String?
  lastCompiledAt DateTime? @map("last_compiled_at")

  nextRunAt     DateTime? @map("next_run_at")
  lockedAt      DateTime? @map("locked_at")
  lockOwner     String?   @map("lock_owner")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")

  lastRunId       String? @map("last_run_id")
  lastTraceId     String? @map("last_trace_id")
  lastDurationMs  Int?    @map("last_duration_ms")
  lastExtractedAt DateTime? @map("last_extracted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refs WikiSourceRef[]
  runs WikiCompileRun[]

  @@index([userId])
  @@index([status])
  @@index([nextRunAt])
  @@index([lockedAt])
  @@map("wiki_sources")
}

model WikiPage {
  id String @id @default(uuid())

  userId String @map("user_id")
  slug   String
  title  String
  summary String?

  type       String @default("concept")
  tags       String @default("[]")
  sources    String @default("[]")
  related    String @default("[]")
  confidence Float  @default(0.5)

  markdown String
  html     String?
  embedding String?

  version Int    @default(1)
  status  String @default("active")

  lastCompiledAt DateTime? @map("last_compiled_at")
  lastSourceId   String?   @map("last_source_id")
  lastRunId      String?   @map("last_run_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refs WikiSourceRef[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@index([userId, slug])
  @@index([userId, type])
  @@map("wiki_pages")
}

model WikiSourceRef {
  id String @id @default(uuid())

  sourceId String @map("source_id")
  pageId   String @map("page_id")
  kind     String
  score    Float?
  metadata String?
  createdAt DateTime @default(now()) @map("created_at")

  source WikiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  page   WikiPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([pageId])
  @@map("wiki_source_refs")
}

model WikiCompileRun {
  id String @id @default(uuid())

  sourceId String @map("source_id")
  status   String @default("running")
  stage    String?
  traceId  String? @map("trace_id")
  metrics  String?
  error    String?
  llmPromptTokens     Int? @map("llm_prompt_tokens")
  llmCompletionTokens Int? @map("llm_completion_tokens")
  llmTotalTokens      Int? @map("llm_total_tokens")
  llmInputChars       Int? @map("llm_input_chars")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  source WikiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([startedAt])
  @@map("wiki_compile_runs")
