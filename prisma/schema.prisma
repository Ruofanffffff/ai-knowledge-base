// This is your Prisma schema file, // learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/knowledge_graph.db"
}

// 用户表
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   @map("hashedPassword")
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 关联关系
  documents Document[]
  settings  Setting[]
  backups   Backup[]
  notes     Note[]     // 新增: 便签关联
  
  @@map("users")
}

// 文档表
model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("document")
  fileType  String?  // .md, .pdf, .docx, .txt
  metadata  String?  // 文档元数据 (JSON string)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 关联关系
  user           User?            @relation(fields: [userId], references: [id])
  tags           DocumentTag[]
  searchItems    SearchHistory[]
  imageAnalyses  ImageAnalysis[]
  
  @@map("documents")
}

// 标签表
model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  color       String        @default("#999999")
  description String?
  documentTag DocumentTag[]
  
  @@map("tags")
}

// 文档标签关联表
model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([documentId, tagId])
  @@map("document_tags")
}

// 搜索历史表
model SearchHistory {
  id          String   @id @default(uuid())
  query       String
  documentId  String?
  userId      String?
  score       Float?   // 搜索结果的相关度
  createdAt   DateTime @default(now())
  
  // 关联关系
  document    Document? @relation(fields: [documentId], references: [id])
  
  @@map("search_history")
}

// 备份表
model Backup {
  id          String   @id @default(uuid())
  filePath    String
  size        Int
  description String?
  userId      String?
  createdAt   DateTime @default(now())
  
  // 关联关系
  user        User?    @relation(fields: [userId], references: [id])
  
  @@map("backups")
}

// 设置表
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关联关系
  user        User?    @relation(fields: [userId], references: [id])
  
  @@map("settings")
}

// ============================================
// LLM Document Index Preprocessing Models
// ============================================

// 文档索引表
// 存储LLM生成的文档索引叙述文本
model DocumentIndex {
  id           String   @id @default(uuid())
  docId        String   @map("doc_id")
  indexedText  String   @map("indexed_text")  // 索引叙述文本
  metadata     String                         // JSON string: {generated_at, llm_model, token_count, fact_count, etc.}
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("document_index")
  @@index([docId])
  @@index([createdAt])
}

// ============================================
// Notes Feature Models
// ============================================

// 便签表
model Note {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  content     String
  tags        String       // JSON string for SQLite compatibility
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  attachments Attachment[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notes")
  @@index([userId])
  @@index([createdAt])
}

// 附件表
model Attachment {
  id          String              @id @default(uuid())
  noteId      String              @map("note_id")
  type        String              // Changed from enum to String for SQLite
  storageKey  String              @map("storage_key")  // S3对象键
  url         String
  size        Int
  mimeType    String              @map("mime_type")
  createdAt   DateTime            @default(now()) @map("created_at")
  
  analysis    AttachmentAnalysis?
  note        Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@map("attachments")
  @@index([noteId])
  @@index([type])
}

// 附件分析表
model AttachmentAnalysis {
  id           String     @id @default(uuid())
  attachmentId String     @unique @map("attachment_id")
  textContent  String?    @map("text_content")
  description  String?
  tags         String     // JSON string for SQLite compatibility
  metadata     String     // JSON string for SQLite compatibility
  createdAt    DateTime   @default(now()) @map("created_at")
  
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  
  @@map("attachment_analysis")
}

// ============================================
// KG Post-Processing Cleaned Models (图谱字段表)
// ============================================

// 清洗实体表 — 图谱字段表的实体部分
model CleanedEntity {
  id              String   @id @default(uuid())
  cleanedName     String   @map("cleaned_name")      // 清洗后名称，≤6个字
  description     String                              // 清洗后描述，≤20个字
  sourceEntityIds String   @map("source_entity_ids")  // JSON string: 关联的原始 KGEntity ID 列表
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  relationsAsSource CleanedRelation[] @relation("CleanedSourceEntity")
  relationsAsTarget CleanedRelation[] @relation("CleanedTargetEntity")

  @@map("cleaned_entities")
  @@index([cleanedName])
}

// 清洗关系表 — 图谱字段表的关系部分
model CleanedRelation {
  id                String   @id @default(uuid())
  cleanedName       String   @map("cleaned_name")        // 清洗后关系名称，≤4个字
  description       String                                // 关系描述
  sourceEntityId    String   @map("source_entity_id")     // 关联的 CleanedEntity（源）
  targetEntityId    String   @map("target_entity_id")     // 关联的 CleanedEntity（目标）
  sourceRelationIds String   @map("source_relation_ids")  // JSON string: 关联的原始 KGRelation ID 列表
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  source CleanedEntity @relation("CleanedSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  target CleanedEntity @relation("CleanedTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@map("cleaned_relations")
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

// ============================================
// KG Dual-Layer Graph Models (双层知识图谱)
// ============================================

// 分文章实体表 — 按文档隔离的实体
model DocEntity {
  id          String   @id @default(uuid())
  docId       String   @map("doc_id")
  cleanedName String   @map("cleaned_name")      // ≤6个字
  description String                              // ≤30个字
  entityType  String   @default("concept") @map("entity_type")  // Entity_Type 枚举值
  source      String   @default("fact")                          // Source_Tag
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  relationsAsSource DocRelation[] @relation("DocSourceEntity")
  relationsAsTarget DocRelation[] @relation("DocTargetEntity")

  @@map("doc_entities")
  @@index([docId])
  @@index([cleanedName])
}

// 分文章关系表 — 按文档隔离的关系
model DocRelation {
  id             String   @id @default(uuid())
  docId          String   @map("doc_id")
  cleanedName    String   @map("cleaned_name")        // ≤4个字
  description    String                                // ≤20个字
  layer          String   @default("how")              // "how" | "why"
  source         String   @default("fact")             // Source_Tag
  sourceEntityId String   @map("source_entity_id")
  targetEntityId String   @map("target_entity_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sourceEntity DocEntity @relation("DocSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity DocEntity @relation("DocTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@map("doc_relations")
  @@index([docId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

// 分文章原则表 — So What 层提取的原则和模式
model DocPrinciple {
  id               String   @id @default(uuid())
  docId            String   @map("doc_id")
  name             String                              // ≤8个字
  description      String                              // ≤40个字
  relatedEntityIds String   @map("related_entity_ids") // JSON string: DocEntity ID 列表
  source           String   @default("pattern")        // Source_Tag
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("doc_principles")
  @@index([docId])
}

// 统一实体表 — 语义归纳后的上层概念实体
model UnifiedEntity {
  id                 String   @id @default(uuid())
  cleanedName        String   @map("cleaned_name")           // ≤6个字
  description        String                                   // ≤20个字，包含目录和总结
  entityType         String   @default("concept") @map("entity_type")  // 新增：Entity_Type 枚举值
  source             String   @default("fact")                          // 新增：Source_Tag
  sourceDocEntityIds String   @map("source_doc_entity_ids")  // JSON: 关联的 DocEntity ID 列表
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  relationsAsSource UnifiedRelation[] @relation("UnifiedSourceEntity")
  relationsAsTarget UnifiedRelation[] @relation("UnifiedTargetEntity")

  @@map("unified_entities")
  @@index([cleanedName])
}

// 统一关系表 — 语义归纳后的上层概念关系
model UnifiedRelation {
  id                    String   @id @default(uuid())
  cleanedName           String   @map("cleaned_name")              // ≤4个字
  description           String                                      // ≤20个字
  layer                 String   @default("how")                    // 新增："how" | "why"
  source                String   @default("fact")                   // 新增：Source_Tag
  sourceEntityId        String   @map("source_entity_id")
  targetEntityId        String   @map("target_entity_id")
  sourceDocRelationIds  String   @map("source_doc_relation_ids")   // JSON: 关联的 DocRelation ID 列表
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  sourceEntity UnifiedEntity @relation("UnifiedSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity UnifiedEntity @relation("UnifiedTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@map("unified_relations")
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

// 统一原则表 — 语义归纳后的上层原则和模式
model UnifiedPrinciple {
  id                     String   @id @default(uuid())
  name                   String                                        // ≤8个字
  description            String                                        // ≤40个字
  source                 String   @default("pattern")                  // Source_Tag
  sourceDocPrincipleIds  String   @map("source_doc_principle_ids")    // JSON string
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("unified_principles")
}

// 统一归纳日志表 — 记录每次统一归纳的执行状态
model UnificationLog {
  id             String    @id @default(uuid())
  status         String                              // 'running' | 'completed' | 'failed'
  entityCount    Int       @default(0) @map("entity_count")
  relationCount  Int       @default(0) @map("relation_count")
  principleCount Int       @default(0) @map("principle_count")  // 新增
  triggeredBy    String    @map("triggered_by")      // 'scheduler' | 'manual'
  error          String?
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("unification_logs")
  @@index([startedAt])
}


// ============================================
// AI Insights Persistence (AI 洞察持久化)
// ============================================

model DocumentInsight {
  id         String   @id @default(uuid())
  docId      String   @unique @map("doc_id")
  concepts   String   // JSON string
  references String   // JSON string
  summary    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("document_insights")
  @@index([docId])
}

// ============================================
// Image Analysis Models (图片 AI 识别)
// ============================================

// 图片分析表 — 存储 LLM 对图片的识别结果
model ImageAnalysis {
  id          String   @id @default(uuid())
  imageKey    String   @map("image_key")
  imageUrl    String   @map("image_url")
  description String?
  elements    String?
  theme       String?
  status      String   @default("pending")
  error       String?
  documentId  String?  @map("document_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("image_analyses")
  @@index([imageKey])
  @@index([documentId])
  @@index([status])
}
