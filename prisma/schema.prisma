// This is your Prisma schema file, // learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/knowledge_graph.db"
}

// 用户表
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   @map("hashedPassword")
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 关联关系
  documents Document[]
  settings  Setting[]
  backups   Backup[]
  notes     Note[]     // 新增: 便签关联
  
  @@map("users")
}

// 文档表
model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("document")
  fileType  String?  // .md, .pdf, .docx, .txt
  metadata  String?  // 文档元数据 (JSON string)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 关联关系
  user        User?            @relation(fields: [userId], references: [id])
  tags        DocumentTag[]
  entities    DocumentEntity[]
  searchItems SearchHistory[]
  ckbs        CKB[]            // 新增: CKB 关联
  
  @@map("documents")
}

// 标签表
model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  color       String        @default("#999999")
  description String?
  documentTag DocumentTag[]
  
  @@map("tags")
}

// 文档标签关联表
model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([documentId, tagId])
  @@map("document_tags")
}

// 实体表
model Entity {
  id          String          @id @default(uuid())
  name        String
  type        String          @default("concept")
  description String?
  metadata    String?         // JSON string
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  // 关联关系
  relationsAsSource EntityRelation[] @relation("SourceEntity")
  relationsAsTarget EntityRelation[] @relation("TargetEntity")
  documentEntities  DocumentEntity[]
  
  @@map("entities")
}

// 实体关系表
model EntityRelation {
  id          String    @id @default(uuid())
  sourceId    String
  targetId    String
  type        String    @default("association")
  strength    Float     @default(0.5) // 0-1之间的关系强度
  description String?
  metadata    String?   // JSON string
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // 外键
  source      Entity    @relation("SourceEntity", fields: [sourceId], references: [id], onDelete: Cascade)
  target      Entity    @relation("TargetEntity", fields: [targetId], references: [id], onDelete: Cascade)
  
  @@map("entity_relations")
}

// 文档实体关联表
model DocumentEntity {
  documentId String
  entityId   String
  score      Float     @default(0.5) // 实体在文档中的相关度
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entity     Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  
  @@id([documentId, entityId])
  @@map("document_entities")
}

// 搜索历史表
model SearchHistory {
  id          String   @id @default(uuid())
  query       String
  documentId  String?
  userId      String?
  score       Float?   // 搜索结果的相关度
  createdAt   DateTime @default(now())
  
  // 关联关系
  document    Document? @relation(fields: [documentId], references: [id])
  
  @@map("search_history")
}

// 备份表
model Backup {
  id          String   @id @default(uuid())
  filePath    String
  size        Int
  description String?
  userId      String?
  createdAt   DateTime @default(now())
  
  // 关联关系
  user        User?    @relation(fields: [userId], references: [id])
  
  @@map("backups")
}

// 设置表
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关联关系
  user        User?    @relation(fields: [userId], references: [id])
  
  @@map("settings")
}


// ============================================
// Knowledge Graph Models (Schema-Driven)
// ============================================

// CKB (Contextual Knowledge Block) 表
model CKB {
  id            String   @id @default(uuid())
  docId         String   @map("doc_id")
  sourceType    String   @map("source_type")  // word | pdf | excel | image | video
  sourceMeta    String   @map("source_meta")  // JSON string
  structure     String                        // JSON string
  content       String                        // JSON string
  quality       String                        // JSON string
  timestamps    String                        // JSON string
  createdAt     DateTime @default(now()) @map("created_at")
  
  document      Document @relation(fields: [docId], references: [id], onDelete: Cascade)
  
  @@map("ckb")
  @@index([docId])
  @@index([sourceType])
}

// Schema 表
model Schema {
  id                 String   @id @default(uuid())
  name               String   @unique
  entityType         String   @map("entity_type")
  scene              String?                       // 场景分类 (科研/政府, 旅行, 摄影等)
  coreFields         String   @map("core_fields")  // JSON string
  threshold          Float
  relations          String?                       // JSON string
  exampleDescription String?  @map("example_description")  // 示例描述
  description        String?                       // Schema 描述
  anchorFields       String?  @map("anchor_fields") // JSON string: 锚点字段配置
  anchorConfig       String?  @map("anchor_config") // JSON string: 锚点配置
  version            String
  active             Boolean  @default(true)       // 是否启用
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  
  @@map("schemas")
  @@index([entityType])
  @@index([scene])
  @@index([active])
}

// KG 实体表
model KGEntity {
  id                String       @id @default(uuid())
  type              String
  canonicalName     String       @map("canonical_name")
  
  // 🆕 锚点相关字段
  anchorFingerprint String?      @map("anchor_fingerprint")  // 锚点指纹
  anchorFields      String?      @map("anchor_fields")       // JSON string: 锚点字段键值对
  
  aliases           String?                       // JSON string
  schemas           String                        // JSON string: [{schema_name, schema_id, confidence}, ...]
  supportedBy       String       @map("supported_by")  // JSON string
  attributes        String?                       // JSON string
  confidence        Float
  llmEnriched       Boolean      @default(false) @map("llm_enriched")
  
  // 🆕 证据定位字段 (CKB Intelligent Chunking)
  evidence          String?                       // JSON string: Evidence location information
  
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  relationsAsSource KGRelation[] @relation("SourceEntity")
  relationsAsTarget KGRelation[] @relation("TargetEntity")
  
  @@map("kg_entities")
  @@index([type])
  @@index([canonicalName])
  @@index([confidence])
  @@index([anchorFingerprint])
  @@index([type, anchorFingerprint])
}

// KG 关系表
model KGRelation {
  id           String   @id @default(uuid())
  sourceId     String   @map("source_id")
  targetId     String   @map("target_id")
  type         String
  subtype      String?
  weight       Float?
  confidence   Float
  evidenceCkb  String   @map("evidence_ckb")  // JSON string
  evidenceText String?  @map("evidence_text")
  
  // 🆕 证据定位字段 (CKB Intelligent Chunking)
  evidence     String?                        // JSON string: Evidence location information
  
  metadata     String?                        // JSON string
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  source       KGEntity @relation("SourceEntity", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KGEntity @relation("TargetEntity", fields: [targetId], references: [id], onDelete: Cascade)
  
  @@map("kg_relations")
  @@index([sourceId])
  @@index([targetId])
  @@index([type])
  @@index([confidence])
}

// KG Token 使用记录表
model KGTokenUsage {
  id           String   @id @default(uuid())
  module       String
  ckbId        String?  @map("ckb_id")
  modelName    String   @map("model_name")
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  totalTokens  Int      @map("total_tokens")
  cost         Float?
  createdAt    DateTime @default(now()) @map("created_at")
  
  @@map("kg_token_usage")
  @@index([module])
  @@index([createdAt])
}

// ============================================
// Document Full Processing Models
// ============================================

// 文档结构分析表
model DocumentStructure {
  id              String   @id @default(uuid())
  docId           String   @map("doc_id")
  fileType        String   @map("file_type")
  totalUnits      Int      @map("total_units")
  units           String   // JSON string: StructuralUnit[]
  hierarchy       String   // JSON string: HierarchyTree
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("document_structures")
  @@index([docId])
}

// 验证报告表
model ValidationReport {
  id              String   @id @default(uuid())
  reportId        String   @unique @map("report_id")
  docId           String   @map("doc_id")
  summary         String   // JSON string: ReportSummary
  structureTree   String   @map("structure_tree")  // JSON string
  skippedContent  String   @map("skipped_content") // JSON string
  lowQualityCkbs  String   @map("low_quality_ckbs") // JSON string
  missingUnits    String   @map("missing_units")    // JSON string
  recommendations String   // JSON string
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("validation_reports")
  @@index([docId])
  @@index([reportId])
}

// 处理监控表
model ProcessingMonitor {
  id              String   @id @default(uuid())
  monitorId       String   @unique @map("monitor_id")
  docId           String   @map("doc_id")
  startTime       DateTime @map("start_time")
  endTime         DateTime? @map("end_time")
  stages          String   // JSON string: ProcessingStage[]
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("processing_monitors")
  @@index([docId])
  @@index([monitorId])
}

// 分段处理表
model SegmentProcessing {
  id              String   @id @default(uuid())
  segmentId       String   @unique @map("segment_id")
  docId           String   @map("doc_id")
  segmentIndex    Int      @map("segment_index")
  totalSegments   Int      @map("total_segments")
  status          String   // 'pending' | 'processing' | 'completed' | 'failed'
  errorMessage    String?  @map("error_message")
  failedAt        DateTime? @map("failed_at")
  recoveredAt     DateTime? @map("recovered_at")
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("segment_processing")
  @@index([docId])
  @@index([segmentId])
  @@index([status])
}

// 告警表
model Alert {
  id              String   @id @default(uuid())
  alertId         String   @unique @map("alert_id")
  alertType       String   @map("alert_type")
  severity        String   // 'info' | 'warning' | 'error' | 'critical'
  message         String
  metadata        String   // JSON string
  triggeredAt     DateTime @map("triggered_at")
  resolvedAt      DateTime? @map("resolved_at")
  status          String   // 'active' | 'resolved' | 'ignored'
  
  @@map("alerts")
  @@index([alertType])
  @@index([severity])
  @@index([status])
}

// 过滤规则表
model FilterRule {
  id              String   @id @default(uuid())
  ruleId          String   @unique @map("rule_id")
  name            String
  type            String   // 'regex' | 'keyword' | 'length' | 'pattern'
  pattern         String
  action          String   // 'skip' | 'mark_low_quality'
  reason          String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("filter_rules")
  @@index([ruleId])
  @@index([enabled])
}

// 字段分布统计表 (Task 7.13.3)
// 记录未映射字段的出现频率，用于指导同义词词典扩充
model FieldDistribution {
  id           String   @id @default(uuid())
  fieldName    String   @unique @map("field_name")
  count        Int      @default(1)
  lastSeen     DateTime @default(now()) @map("last_seen")
  schemas      String   // JSON array of schema names where this field appeared
  fieldType    String?  @map("field_type") // time, location, number, etc.
  exampleValue String?  @map("example_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("field_distribution")
  @@index([count])
  @@index([lastSeen])
  @@index([fieldType])
}

// ============================================
// Relation Type Expansion Models
// ============================================

// 关系类型定义表
// 定义知识图谱中可用的关系类型，支持多领域（生活、工作、旅行、购物、政务、管理）
model RelationType {
  id                 String   @id @default(uuid())
  relationTypeId     String   @unique @map("relation_type_id")  // 唯一标识符，如 "family_parent"
  name               String                                      // 英文名称，如 "parent"
  displayName        String   @map("display_name")              // 中文显示名称，如 "父母"
  description        String?                                     // 语义描述
  domain             String                                      // 所属领域：life/work/travel/shopping/government/management
  category           String                                      // 二级分类，如 "family"/"employment"
  sourceEntityTypes  String   @map("source_entity_types")       // JSON array: 允许的源实体类型
  targetEntityTypes  String   @map("target_entity_types")       // JSON array: 允许的目标实体类型
  isDirectional      Boolean  @default(true) @map("is_directional")      // 是否有方向性
  isTemporal         Boolean  @default(false) @map("is_temporal")        // 是否具有时效性
  supportsConfidence Boolean  @default(true) @map("supports_confidence") // 是否支持置信度
  parentType         String?  @map("parent_type")               // 父类型ID（用于继承）
  metadata           String?                                     // JSON: 扩展元数据
  version            String   @default("1.0.0")                 // 版本号
  active             Boolean  @default(true)                    // 是否激活
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  
  @@map("relation_types")
  @@index([domain])
  @@index([category])
  @@index([active])
}

// ============================================
// LLM Document Index Preprocessing Models
// ============================================

// 文档索引表
// 存储LLM生成的文档索引叙述文本
model DocumentIndex {
  id           String   @id @default(uuid())
  docId        String   @map("doc_id")
  indexedText  String   @map("indexed_text")  // 索引叙述文本
  metadata     String                         // JSON string: {generated_at, llm_model, token_count, fact_count, etc.}
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("document_index")
  @@index([docId])
  @@index([createdAt])
}

// 矫正记录表
// 存储各个处理阶段的矫正操作记录
model CorrectionRecord {
  id               String   @id @default(uuid())
  docId            String   @map("doc_id")
  stage            String   // cbk_correction, field_correction, schema_correction, merge_correction, relation_correction
  correctionType   String   @map("correction_type")  // supplement, filter, verify, adjust
  originalValue    String?  @map("original_value")   // JSON string
  correctedValue   String?  @map("corrected_value")  // JSON string
  confidenceBefore Float?   @map("confidence_before")
  confidenceAfter  Float?   @map("confidence_after")
  metadata         String?                           // JSON string: additional context
  createdAt        DateTime @default(now()) @map("created_at")
  
  @@map("correction_record")
  @@index([docId])
  @@index([stage])
  @@index([docId, stage])
  @@index([createdAt])
}

// 矫正统计表
// 存储各个处理阶段的矫正统计信息
model CorrectionStats {
  id               String   @id @default(uuid())
  docId            String   @map("doc_id")
  stage            String   // cbk_correction, field_correction, schema_correction, merge_correction, relation_correction
  totalCorrections Int      @default(0) @map("total_corrections")
  accuracyBefore   Float?   @map("accuracy_before")
  accuracyAfter    Float?   @map("accuracy_after")
  recallBefore     Float?   @map("recall_before")
  recallAfter      Float?   @map("recall_after")
  precisionBefore  Float?   @map("precision_before")
  precisionAfter   Float?   @map("precision_after")
  metadata         String?                          // JSON string: additional metrics
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  
  @@map("correction_stats")
  @@unique([docId, stage])
  @@index([docId])
  @@index([stage])
}

// 图谱描述表
// 存储知识图谱的自然语言描述
model GraphDescription {
  id              String   @id @default(uuid())
  docId           String   @map("doc_id")
  descriptionType String   @map("description_type")  // brief, detailed
  description     String                             // 图谱描述文本
  metadata        String?                            // JSON string: {entity_count, relation_count, etc.}
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("graph_description")
  @@index([docId])
  @@index([descriptionType])
}

// ============================================
// Notes Feature Models
// ============================================

// 便签表
model Note {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  content     String
  tags        String       // JSON string for SQLite compatibility
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  attachments Attachment[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notes")
  @@index([userId])
  @@index([createdAt])
}

// 附件表
model Attachment {
  id          String              @id @default(uuid())
  noteId      String              @map("note_id")
  type        String              // Changed from enum to String for SQLite
  storageKey  String              @map("storage_key")  // S3对象键
  url         String
  size        Int
  mimeType    String              @map("mime_type")
  createdAt   DateTime            @default(now()) @map("created_at")
  
  analysis    AttachmentAnalysis?
  note        Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@map("attachments")
  @@index([noteId])
  @@index([type])
}

// 附件分析表
model AttachmentAnalysis {
  id           String     @id @default(uuid())
  attachmentId String     @unique @map("attachment_id")
  textContent  String?    @map("text_content")
  description  String?
  tags         String     // JSON string for SQLite compatibility
  metadata     String     // JSON string for SQLite compatibility
  createdAt    DateTime   @default(now()) @map("created_at")
  
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  
  @@map("attachment_analysis")
}

// ============================================
// KG Post-Processing Cleaned Models (图谱字段表)
// ============================================

// 清洗实体表 — 图谱字段表的实体部分
model CleanedEntity {
  id              String   @id @default(uuid())
  cleanedName     String   @map("cleaned_name")      // 清洗后名称，≤6个字
  description     String                              // 清洗后描述，≤20个字
  sourceEntityIds String   @map("source_entity_ids")  // JSON string: 关联的原始 KGEntity ID 列表
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  relationsAsSource CleanedRelation[] @relation("CleanedSourceEntity")
  relationsAsTarget CleanedRelation[] @relation("CleanedTargetEntity")

  @@map("cleaned_entities")
  @@index([cleanedName])
}

// 清洗关系表 — 图谱字段表的关系部分
model CleanedRelation {
  id                String   @id @default(uuid())
  cleanedName       String   @map("cleaned_name")        // 清洗后关系名称，≤4个字
  description       String                                // 关系描述
  sourceEntityId    String   @map("source_entity_id")     // 关联的 CleanedEntity（源）
  targetEntityId    String   @map("target_entity_id")     // 关联的 CleanedEntity（目标）
  sourceRelationIds String   @map("source_relation_ids")  // JSON string: 关联的原始 KGRelation ID 列表
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  source CleanedEntity @relation("CleanedSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  target CleanedEntity @relation("CleanedTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@map("cleaned_relations")
  @@index([sourceEntityId])
  @@index([targetEntityId])
}
