<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/server" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">192.168.0.122</domain>
        <trust-anchors>
            <certificates src="@raw/server" />
        </trust-anchors>
    </domain-config>
</network-security-config>