{
  "name": "shisi",
  "productName": "拾思",
  "version": "1.0.1",
  "private": true,
  "description": "AI知识库管理应用",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "cd client && npm test",
    "lint": "cd client && npm run lint",
    "electron:dev": "concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron ."
  },
  "build": {
    "appId": "com.shisi.desktop",
    "productName": "拾思",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "server.js",
      "routes/**/*",
      "controllers/**/*",
      "services/**/*",
      "middleware/**/*",
      "config/**/*",
      "database/**/*",
      "prisma/**/*",
      ".env",
      ".env.production"
    ],
    "asarUnpack": [
      "server.js",
      "routes/**/*",
      "controllers/**/*",
      "services/**/*",
      "middleware/**/*",
      "config/**/*",
      "database/**/*",
      "prisma/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@alicloud/openapi-client": "^0.4.15",
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/lib-storage": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.989.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@prisma/client": "^5.0.0",
    "antd-mobile-rn": "^2.3.3",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "compromise": "^14.14.5",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "mime": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.0",
    "openai": "^6.22.0",
    "p-queue": "^6.6.2",
    "pdf-parse": "^2.4.5",
    "segment": "^0.1.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.6",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.2",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "fast-check": "^4.5.3",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "wait-on": "^9.0.4"
  }
}
