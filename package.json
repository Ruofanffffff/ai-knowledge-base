{
  "name": "personal-knowledge-base",
  "version": "1.0.0",
  "description": "A personal knowledge base with AI features",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "electron . --dev",
    "build": "npm run build:react && electron-builder",
    "build:react": "vite build",
    "install:all": "npm install && cd client && npm install",
    "test": "jest",
    "android:build": "./build-android.sh",
    "android:dev": "./dev-android.sh",
    "android:sync": "cd client && npm run build && cd .. && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "keywords": [
    "knowledge",
    "base",
    "ai",
    "electron",
    "react",
    "android",
    "capacitor"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.6.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docx": "^8.5.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.32.0",
    "sqlite3": "^5.1.6",
    "tesseract.js": "^5.0.0"
  }
}
