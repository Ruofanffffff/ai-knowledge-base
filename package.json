{
  "name": "personal-knowledge-base",
  "version": "1.0.0",
  "description": "A personal knowledge base with AI features and Schema-Driven Knowledge Graph",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "electron . --dev",
    "build": "npm run build:react && electron-builder",
    "build:react": "vite build",
    "install:all": "npm install && cd client && npm install",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --maxWorkers=2",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=test.js",
    "test:property": "jest --testPathPattern=property.test",
    "lint": "echo 'Linting not configured yet'",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "schema:import": "node kg/schema/load_schemas.js",
    "schema:check": "node kg/schema/schema_startup_check.js",
    "android:build": "./build-android.sh",
    "android:dev": "./dev-android.sh",
    "android:sync": "cd client && npm run build && cd .. && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "keywords": [
    "knowledge",
    "base",
    "ai",
    "electron",
    "react",
    "knowledge-graph",
    "schema-driven",
    "llm",
    "token-optimization",
    "android",
    "capacitor"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "fast-check": "^4.5.3",
    "jest": "^29.6.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docx": "^8.5.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "nodejieba": "^3.5.2",
    "pdf-parse": "^1.1.4",
    "prisma": "^5.22.0",
    "sharp": "^0.32.0",
    "sqlite3": "^5.1.6",
    "tesseract.js": "^5.0.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  }
}
